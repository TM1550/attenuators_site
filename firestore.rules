rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'mZfT9dN19RPo9Jo5P8u8SYgIKMt1';
    }
    function validRecord(documentId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'identity_key', 'identity_hash', 'name', 'organism', 'target', 'category', 'mechanism', 'status', 'references', 'aliases', 'created_at', 'updated_at'])
        && d.id is string && d.id.size() > 0
        && d.identity_key is string && d.identity_key.size() > 0 && d.identity_key.size() <= 400
        && d.identity_hash == documentId
        && d.name is string && d.organism is string && d.target is string
        && d.category is string && d.mechanism is string
        && d.references is list && d.aliases is list
        && d.status in ['candidate', 'under_review', 'confirmed', 'rejected']
        && (d.status != 'confirmed' ||
          (d.transcription_attenuation_confirmed == true && d.references.size() > 0
           && d.experimental_evidence is string && d.experimental_evidence.size() > 0
           && d.evidence_level is string))
        && d.updated_at == request.time;
    }
    match /attenuators/{documentId} {
      allow read: if isAdmin() || resource.data.status == 'confirmed';
      allow create: if isAdmin() && validRecord(documentId)
        && request.resource.data.created_at == request.time;
      allow update: if isAdmin() && validRecord(documentId)
        && request.resource.data.identity_key == resource.data.identity_key
        && request.resource.data.identity_hash == resource.data.identity_hash
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
